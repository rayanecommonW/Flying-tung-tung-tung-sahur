{
  "name": "backend",
  "version": "0.0.0",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch ./src/index.ts",
    "start": "bun src/index.ts",
    "build": "echo \"Backend uses bun runtime; no build step\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No tests yet\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@flying-tung-tung/shared": "workspace:*",
    "@socket.io/bun-engine": "^0.0.3",
    "dotenv": "^16.0.0",
    "hono": "^4.10.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "^3.4.1",
    "typescript": "^5.4.0"
  }
}
